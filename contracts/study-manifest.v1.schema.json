{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "betabots.study-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "researchQuestion", "hypotheses", "target", "environment", "arms", "interactionPolicyRef", "authenticationLifecyclePolicy", "evidenceRequirements", "reproducibility", "limitations"],
  "properties": {
    "schema": {"const": "betabots.study-manifest.v1"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "researchQuestion": {"type": "string", "minLength": 1},
    "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "target": {"$ref": "#/$defs/target"},
    "environment": {"$ref": "#/$defs/environment"},
    "arms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/arm"}},
    "interactionPolicyRef": {"type": "string", "minLength": 1},
    "authenticationLifecyclePolicy": {"enum": ["none", "no-auth", "transient-user-approved"]},
    "evidenceRequirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRequirement"}},
    "reproducibility": {"$ref": "#/$defs/reproducibility"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "target": {"type": "object", "additionalProperties": false, "required": ["app", "startUrls"], "properties": {"app": {"type": "string", "minLength": 1}, "startUrls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["attestationMode"], "properties": {"attestationMode": {"enum": ["required", "optional", "not-required"]}}},
    "arm": {"type": "object", "additionalProperties": false, "required": ["id", "type", "personaRefs", "tasks"], "properties": {"id": {"type": "string", "minLength": 1}, "type": {"enum": ["neutral", "conversion", "treatment"]}, "personaRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "tasks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "evidenceRequirement": {"type": "object", "additionalProperties": false, "required": ["classification", "artifactType", "minimumCount"], "properties": {"classification": {"enum": ["observed", "inferred", "recommendation", "external", "unverified"]}, "artifactType": {"enum": ["screenshot", "event", "path"]}, "minimumCount": {"type": "integer", "minimum": 1}, "armId": {"type": "string", "minLength": 1}}},
    "reproducibility": {"type": "object", "additionalProperties": false, "required": ["seed", "engine", "model"], "properties": {"seed": {"type": "string", "minLength": 1}, "engine": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}}}
  }
}
